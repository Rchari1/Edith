#!/usr/bin/env python3
"""
Edith status line for Claude Code.

Reads the session JSON Claude Code puts on stdin, asks the local Edith server
what happened in *this* session, and prints one line above the footer.

Claude Code cancels the script if a new update fires while it is still running,
and debounces at 300ms - so this stays a single process with a hard 1s timeout
and never blocks. If Edith is not running it prints a dim marker rather than an
error, because a status line that shouts about its own failure is worse than
one that quietly says "offline".
"""
import json
import sys
import urllib.request

PORTS = (4319, 4320, 4321, 4322)

CYAN = "\033[38;5;117m"
DIM = "\033[38;5;240m"
TEXT = "\033[38;5;250m"
RESET = "\033[0m"
MARK = "◈"


def read_session_id() -> str:
    try:
        payload = json.load(sys.stdin)
    except Exception:
        return ""
    if not isinstance(payload, dict):
        return ""
    return str(payload.get("session_id") or "")


def ask_edith(session_id: str):
    path = f"/session/{session_id}" if session_id else "/session/unknown"
    for port in PORTS:
        try:
            with urllib.request.urlopen(f"http://127.0.0.1:{port}{path}", timeout=1) as r:
                return json.load(r)
        except Exception:
            continue
    return None


def main() -> None:
    data = ask_edith(read_session_id())

    if not data:
        print(f"{DIM}{MARK} Edith offline{RESET}")
        return

    notes = data.get("notes", 0)
    s = data.get("session") or {}
    recalled = int(s.get("searches", 0)) + int(s.get("reads", 0))
    saved = int(s.get("saves", 0))

    parts = [f"{CYAN}{MARK} Edith{RESET}"]
    parts.append(f"{TEXT}{notes} memor{'y' if notes == 1 else 'ies'}{RESET}")
    if recalled:
        parts.append(f"{TEXT}{recalled} recalled{RESET}")
    if saved:
        parts.append(f"{TEXT}{saved} formed{RESET}")
    if not recalled and not saved:
        parts.append(f"{DIM}idle{RESET}")

    print(f" {DIM}·{RESET} ".join(parts))


if __name__ == "__main__":
    main()
